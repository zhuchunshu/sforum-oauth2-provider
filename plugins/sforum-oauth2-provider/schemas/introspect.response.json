  "$id": "sforum.oauth2-provider.route.introspect.response@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["active"],
  "properties": {
    "active": { "type": "boolean" },
    "scope": { "type": "string" },
    "client_id": { "type": "string" },
    "username": { "type": "string" },
    "sub": { "type": "string" },
    "token_type": { "type": "string" },
    "exp": { "type": "integer" },
    "iat": { "type": "integer" },
    "error": { "type": "string" },
    "errorDescription": { "type": "string" }
  }
}
