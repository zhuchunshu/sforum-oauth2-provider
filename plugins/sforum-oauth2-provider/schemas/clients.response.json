{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.oauth2-provider.route.clients.response@7",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clients",
        "canManageAll",
        "canCreate",
        "allowUserClients"
      ],
      "properties": {
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clientId",
              "name",
              "description",
              "clientType",
              "redirectUris",
              "scopes",
              "ownerUserId",
              "ownerName",
              "createdAt"
            ],
            "properties": {
              "clientId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "clientType": {
                "type": "string",
                "enum": [
                  "confidential",
                  "public"
                ]
              },
              "logoUrl": {
                "type": "string"
              },
              "attachmentPublicId": {
                "type": "string"
              },
              "icon": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "pattern", "background", "color"],
                "properties": {
                  "kind": { "type": "string", "enum": ["attachment", "url", "generated"] },
                  "url": { "type": "string" },
                  "pattern": { "type": "string", "pattern": "^[01]{25}$" },
                  "background": { "type": "string" },
                  "color": { "type": "string" }
                }
              },
              "redirectUris": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ownerUserId": {
                "type": "integer"
              },
              "ownerName": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "lastUsedAt": {
                "type": "string"
              },
              "hasSecret": {
                "type": "boolean"
              }
            }
          }
        },
        "canManageAll": {
          "type": "boolean"
        },
        "canCreate": {
          "type": "boolean"
        },
        "allowUserClients": {
          "type": "boolean"
        },
        "allowedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopeCatalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "alwaysOn"],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "alwaysOn": {
                "type": "boolean"
              }
            }
          }
        },
        "source": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "type": "string" },
        "errorDescription": { "type": "string" }
      }
    }
  ]
}
