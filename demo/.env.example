# OAuth2 demo 配置 — 复制为 .env 并填入真实值
# 授权服务器地址（本地站点）
SFO_BASE_URL=http://127.0.0.1:3000
# 后台「OAuth2 应用」创建后得到的 Client ID
CLIENT_ID=
# 一次性明文密钥；公开客户端留空（强制 PKCE）
CLIENT_SECRET=
# demo 监听端口（回调地址随之变为 http://127.0.0.1:<PORT>/callback）
PORT=9000
# 申请的权限范围（空格分隔，如 "profile avatar"）；留空则不传 scope，
# 由授权服务器回落到应用在后台登记的范围。
# SCOPES=
