{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.oauth2-provider.route.authorizations.response@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorizations", "canManageAll"],
  "properties": {
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientId", "clientName", "scopes", "createdAt", "updatedAt"],
        "properties": {
          "clientId": { "type": "string" },
          "clientName": { "type": "string" },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      }
    },
    "canManageAll": { "type": "boolean" },
    "source": { "type": "string" }
  }
}
