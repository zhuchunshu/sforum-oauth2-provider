{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.oauth2-provider.route.revoke.request@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["token"],
  "properties": {
    "token": { "type": "string", "minLength": 8, "maxLength": 256 },
    "token_type_hint": { "type": "string", "enum": ["access_token", "refresh_token"] },
    "client_id": { "type": "string", "maxLength": 128 },
    "client_secret": { "type": "string", "maxLength": 256 }
  }
}
