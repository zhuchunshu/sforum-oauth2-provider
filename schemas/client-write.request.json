{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.oauth2-provider.route.client-write.request@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "redirectUris"],
  "properties": {
    "clientId": { "type": "string", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "clientType": { "type": "string", "enum": ["confidential", "public"] },
    "redirectUris": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 8, "maxLength": 2048 }
    },
    "scopes": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string" }
    },
    "ownerUserId": { "type": "integer" }
  }
}
